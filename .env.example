# Kopyahin ito sa .env at palitan ang mga values.
# HUWAG i-commit ang .env sa Git.

# Mahabang random string (nag-sign ng session cookies)
SECRET_KEY=change-me-to-a-long-random-string

# development o production
FLASK_ENV=development

# 1 = i-on ang Flask debugger (dev lang; HUWAG sa production)
FLASK_DEBUG=0

# Storage ng rate limiter (in-memory by default). Sa VPS with maraming
# gunicorn workers, gamitin ang local Redis:
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379

# Database (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db
# Path sa CA cert para sa SSL (kailangan ng managed MySQL tulad ng Aiven).
# Hal. DB_SSL_CA=certs/aiven-ca.pem  (iwan blangko sa local XAMPP)
DB_SSL_CA=
# Kung 1 at walang DB_SSL_CA: encrypted connection pero hindi bine-verify ang
# cert. Gamitin ito para sa Aiven/PlanetScale kung ayaw mag-download ng CA.
DB_SSL_REQUIRED=0

# Gawing 1 kapag naka-HTTPS na sa production
SESSION_COOKIE_SECURE=0

# AI Assistant (OpenAI-compatible). Iwan na blangko para i-disable.
# Pwede: OpenAI, OpenRouter, Groq, Together, at iba pa (baguhin ang base URL).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Social links (blangko = nakatago ang button sa Contact page)
FACEBOOK_URL=
TIKTOK_URL=

# Email notification para sa contact form (SMTP). Blangko = disabled.
# Gmail: kailangan ng App Password (hindi ang normal na password).
#   1. I-enable ang 2-Step Verification sa Google account
#   2. Google Account > Security > App passwords > gumawa ng bagong password
#   3. Ilagay ang 16-char na password sa SMTP_PASSWORD
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=
MAIL_TO=your.email@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Email via HTTP API (Resend) ---
# Para sa online host na hinaharang ang SMTP (hal. Render free).
# Kung naka-set ang RESEND_API_KEY, ito ang gagamitin imbes na SMTP.
# Free tier: onboarding@resend.dev muna (mapapadala lang sa email ng account mo).
RESEND_API_KEY=
MAIL_FROM=Portfolio <onboarding@resend.dev>

# --- Cloud image storage (Cloudinary) ---
# Kung naka-set, dito naka-save ang project/template images (hindi nawawala
# sa redeploy ng online host). Kunin sa Cloudinary Dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
